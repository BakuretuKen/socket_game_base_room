<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>simple code share</title>
    <link rel="shortcut icon" href="/favicon.ico">
    <meta name="robots" content="noindex,nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <h1>GAME PAGE</h1>
    </header>
    <main>
        <div id="message" style="display: none;"></div>
        <div id="errorMessage" style="display: none;"></div>
        <div id="backToTop" style="display: none;">
            <button onclick="goToTop();">トップページへ戻る</button>
        </div>
        <input type="hidden" id="gameCode" value="<%= gameCode %>">
        <input type="hidden" id="userName" value="<%= userName %>">
        <input type="hidden" id="master" value="<%= master %>">

        <!-- 待機ルーム -->
        <div id="waitingRoom">
            <h3>待機ルーム</h3>
            <% if (master == "1") { %>
                <div id="gameCodePanel" style="display: none;" title="クリックでコピー">
                    <span class="label">GAME CODE</span>
                    <span id="gameCodeValue"></span>
                </div>
            <% } %>
            <ol id="waitingRoomList"></ol>
            <% if (master == "1") { %>
                <button id="startGameButton" disabled onclick="sendMessage({action: 'START_GAME'});">ゲーム開始</button>
            <% } %>
        </div>
        <!-- ゲーム画面 -->
        <div id="gameScreen" style="display: none;">
            <h3>ゲーム画面</h3>
        </div>

        <!-- デバッグ用（ゲーム開始後にのみ表示） -->
        <div id="debugArea" style="display: none;">
            <hr/>
            <div id="debugButtons">
                DEBUG：
                <button class="debug" onclick="console.log(players); debugLog('players:', players);">players</button>
                <button class="debug" onclick="console.log(playerName); debugLog('playerName:', playerName);">playerName</button>
                <button class="debug" onclick="console.log(isMaster); debugLog('isMaster:', isMaster);">isMaster</button>
                | <input type="text" id="debugMessage" value="debug message" autocomplete="off"> <button class="debug" onclick="sendMessage({action: 'SEND_DEBUG', message: document.getElementById('debugMessage').value});">send_all</button>
                <br />
                <input type="text" id="debugDirectMessageSocketId" placeholder="socketId" autocomplete="off">
                <button class="debug" onclick="sendDirectMessage(document.getElementById('debugDirectMessageSocketId').value, {action: 'SEND_DIRECT_DEBUG', message: document.getElementById('debugMessage').value});">send_direct</button>
                <textarea id="debugLog" readonly placeholder="受信ログ"></textarea>
            </div>
        </div>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/dist/views/game_base.js"></script>
    <!-- マスターJS、プレイヤーJSを切り替える場合 -->
    <% if (master == 1) { %>
        <script src="/dist/views/game_master.js"></script>
    <% } else { %>
        <script src="/dist/views/game_player.js"></script>
    <% } %>

    <!-- マスターJS、プレイヤーJSを切り替えない場合 -->
    <!-- <script src="/dist/views/game.js"></script> -->
</body>
</html>
